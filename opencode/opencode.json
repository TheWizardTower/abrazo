  },
  "agent": {
    "plan": {
      "description": "Architecture and planning on turkishDelight; prefer no edits",
      "mode": "primary",
      "model": "turkishDelight/architect",
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    },
    "build": {
      "description": "Implementation on turkishDelight big coder",
      "mode": "primary",
      "model": "turkishDelight/coder-big",
      "permission": {
        "edit": "allow",
        "bash": "ask"
      }
    },
    "explore": {
      "description": "Fast read-only codebase search via laptop peer",
      "mode": "subagent",
      "model": "turkishDelight/golem-coder",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "general": {
      "description": "Multi-step work on Golem prose peer",
      "mode": "subagent",
      "model": "turkishDelight/golem-prose"
    },
    "golem-coder": {
      "description": "Focused implementation on Golem coder peer",
      "mode": "subagent",
      "model": "turkishDelight/golem-coder",
      "permission": {
        "edit": "allow",
        "bash": "ask"
      }
    },
    "laptop-coder": {
      "description": "Small coding tasks on laptop coder peer",
      "mode": "subagent",
      "model": "turkishDelight/laptop-coder",
      "permission": {
        "edit": "allow",
        "bash": "ask"
      }
    }
  },
  "plugin": [
    "cc-safety-net"
  ],
  "instructions": [
    "~/.config/opencode/plugin/shell-strategy/shell_strategy.md"
  ]
}
