{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "lsp": "allow",
    "edit": "deny",
    "bash": "deny",
    "webfetch": "deny",
    "write": "deny",
    "read": "deny",
    "glob": "deny",
    "grep": "deny",
    "list": "deny",
    "semgrep_*": "deny",
    "vigil_*": "deny",
    "grafana_*": "deny",
    "serena_*": "deny",
    "kubernetes_*": "deny",
    "context7_*": "deny"
  },
  "lsp": {
    "basedpyright": {
      "command": [
        "basedpyright-langserver",
        "--stdio"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ]
    },
    "html-lsp": {
      "command": [
        "vscode-html-language-server",
        "--stdio"
      ],
      "extensions": [
        ".html",
        ".htm"
      ]
    },
    "harper-ls": {
      "command": [
        "harper-ls",
        "--stdio"
      ],
      "extensions": [
        ".md",
        ".markdown"
      ]
    },
    "markdown-oxide": {
      "command": [
        "markdown-oxide"
      ],
      "extensions": [
        ".md",
        ".markdown"
      ]
    },
    "typos-lsp": {
      "command": [
        "typos-lsp"
      ],
      "extensions": [
        ".py",
        ".rs",
        ".js",
        ".ts",
        ".tsx",
        ".jsx",
        ".go",
        ".sh",
        ".lua",
        ".md",
        ".toml",
        ".yaml",
        ".yml",
        ".json"
      ]
    },
    "snyk-ls": {
      "command": [
        "snyk-ls"
      ],
      "extensions": [
        ".py",
        ".js",
        ".ts",
        ".go",
        ".rs"
      ]
    }
  },
  "provider": {
    "turkishDelight": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-swap",
      "options": {
        "baseURL": "http://turkishDelight:8080/v1"
      },
      "models": {
        "Gemma-4-26B-A4B-UD-Q6_K": {
          "name": "Gemma 4 26B-A4B Q6_K — Fast & Natural",
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 131072,
            "output": 65536
          },
          "options": {
            "temperature": 0.85,
            "topP": 0.95
          }
        },
        "Qwen3.6-35B-A3B-MTP-UD-Q8": {
          "name": "Qwen3.6-35B-A3B MTP Q8 — Fast & Strong (MTP enabled)",
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 131072,
            "output": 65536
          },
          "options": {
            "temperature": 0.9,
            "topP": 0.95
          }
        },
        "Qwen3-Coder-Next-UD-Q8": {
          "name": "Qwen3-Coder-Next-UD-Q8_K_XL",
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
